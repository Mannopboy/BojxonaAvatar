# === BojxonaAvatar backend (shablon — git'ga kiradi, MAXFIY QIYMAT YOZMANG) ===
# Haqiqiy kalitni .env ga yozing (.env git'ga kirmaydi).
# Gemini API kaliti: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Gemini Live (jonli ovozli suhbat)
GEMINI_VOICE=Kore
GEMINI_LIVE_MODEL=gemini-3.8-live-extended-thinking
GEMINI_LIVE_THINKING=LOW

# Ovoz zanjiri: tts (Gemini matn modeli + gemini-3.8-flash-tts, tavsiya) yoki live (Gemini Live)
VOICE_ENGINE=tts
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Grounding (rasmiy web qidiruv)
GROUNDING_ENABLED=true
ALLOWED_SOURCES=customs.uz,lex.uz,gov.uz,my.gov.uz

# DB
DATABASE_URL=sqlite:///./app.db

# CORS (kiosk / frontend origin)
FRONTEND_ORIGIN=http://localhost:5173
