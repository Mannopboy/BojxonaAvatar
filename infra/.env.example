# BojxonaAvatar deploy .env — SERVERDA: /opt/bojxonaavatar/infra/.env
# (git'ga KIRMAYDI — bu faqat shablon)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

GROUNDING_ENABLED=true
# Ovozli suhbat: tayyor javobga mos kelmagan savol internetdan qidiriladi (Google Search grounding). false — eski usul (faqat tasdiqlangan faktlar)
VOICE_WEB_SEARCH=true
# true — faqat rasmiy manba (ALLOWED_SOURCES) asosidagi qidiruv javobi aytiladi, aks holda «topa olmadim». false — norasmiy manbadagi javob ham aytiladi, oxirida «bojxona xodimiga aniqlashtiring»
VOICE_SEARCH_OFFICIAL_ONLY=false
ALLOWED_SOURCES=customs.uz,lex.uz,gov.uz,my.gov.uz

# Prod DB — SQLite volume (compose'da ham bor)
DATABASE_URL=sqlite:////app/data/app.db

# Prod domen (CORS uchun — bir xil origin bo'lsa ahamiyatsiz)
FRONTEND_ORIGIN=https://bojxona.fintech-company.uz

# Kiosk ilova (bojxona_gologramma) reliz yuklash: POST /api/app/windows/release uchun X-Admin-Key. BO'SH bo'lsa yuklash o'chiq (503) — qo'lda qo'yish ham mumkin.
# Kalit yaratish: python -c "import secrets; print(secrets.token_urlsafe(32))"
RELEASE_ADMIN_KEY=
