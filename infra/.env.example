# BojxonaAvatar deploy .env — SERVERDA: /opt/bojxonaavatar/infra/.env
# (git'ga KIRMAYDI — bu faqat shablon)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

GROUNDING_ENABLED=true
ALLOWED_SOURCES=customs.uz,lex.uz,gov.uz,my.gov.uz

# Prod DB — SQLite volume (compose'da ham bor)
DATABASE_URL=sqlite:////app/data/app.db

# Prod domen (CORS uchun — bir xil origin bo'lsa ahamiyatsiz)
FRONTEND_ORIGIN=https://bojxona.example.uz
